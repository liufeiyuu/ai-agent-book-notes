# Copy to .env and configure locally. Never paste the API key into chat.
OPENROUTER_API_KEY=
# Reuse the tool-calling model selected in the first-week project.
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Per-command limits; API pricing still depends on the chosen model.
MAX_API_CALLS=24
MAX_OUTPUT_TOKENS=1500
