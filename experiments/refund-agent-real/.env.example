# Copy to .env and configure locally. Never paste the API key into chat.
OPENROUTER_API_KEY=
# Reuse the tool-calling model selected in the Stage 1 project.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Per-command limits; API pricing still depends on the chosen model.
MAX_API_CALLS=40
MAX_OUTPUT_TOKENS=1500
